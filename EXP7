        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Load dataset\n",
        "data = pd.read_csv(\"sales_map_data.csv\")\n",
        "\n",
        "# Rename columns\n",
        "data.columns = [\"Sales\", \"Quantity\"]\n",
        "\n",
        "# Scatter plot\n",
        "plt.scatter(data[\"Sales\"], data[\"Quantity\"])\n",
        "plt.xlabel(\"Sales\")\n",
        "plt.ylabel(\"Quantity\")\n",
        "plt.title(\"Scatter Plot: Sales vs Quantity\")\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ],
