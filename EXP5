      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Load dataset\n",
        "data = pd.read_csv(\"sales_data.csv\", header=None, skiprows=1)\n",
        "\n",
        "# Set column names\n",
        "data.columns = [\"OrderID\", \"Product\", \"Category\", \"Sales\", \"Quantity\", \"Region\"]\n",
        "\n",
        "# Display first five rows\n",
        "print(\"First five rows:\")\n",
        "print(data.head())\n",
        "\n",
        "# Check missing values\n",
        "print(\"\\nMissing values:\")\n",
        "print(data.isnull().sum())\n",
        "\n",
        "# Remove duplicate records\n",
        "data = data.drop_duplicates()\n",
        "\n",
        "# Convert Sales column to numeric\n",
        "data[\"Sales\"] = pd.to_numeric(data[\"Sales\"], errors=\"coerce\")\n",
        "\n",
        "# Remove rows with missing Sales values, if any\n",
        "data = data.dropna(subset=[\"Sales\"])\n",
        "\n",
        "# Save cleaned dataset\n",
        "data.to_csv(\"cleaned_sales_data.csv\", index=False)\n",
        "\n",
        "# Display success message\n",
        "print(\"\\nData prepared successfully.\")\n",
        "print(\"Cleaned dataset saved as cleaned_sales_data.csv\")"
